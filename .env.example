# Copiez ce fichier en .env pour surcharger les valeurs par défaut de docker-compose.yml.
# Remplacez les secrets avant le démarrage. Le mot de passe PostgreSQL utilise
# uniquement des caractères URL-sûrs (lettres, chiffres, tirets, underscores).

WEB_PORT=8080

# Compte administrateur créé au premier démarrage.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Replace-With-Unique-Random-Password

# À remplacer avant toute mise en ligne.
SECRET_KEY=replace-with-a-long-random-django-secret-key
POSTGRES_PASSWORD=Replace-With-Long-Random-Url-Safe-Password
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Adresses autorisées (à adapter si le site est servi sous un autre nom de domaine).
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_BASE_URL=http://localhost:8080

# En local, les emails apparaissent dans les journaux du backend.
# En production, choisissez le backend SMTP et fournissez le serveur et ses identifiants.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@localhost
